# Dependencies and runtime output, plus the orchestration state the
# local `.git/info/exclude` also carries (ledger says Task 1 repeats those
# entries), so a clone does not show them as untracked.
.superpowers/
.pi/
node_modules/
# lib/ is committed so Git installs need no lifecycle build scripts.
dist/
coverage/
.dev-home/
.pnpm-store/

# Local logs and TypeScript build metadata.
*.log
*.tsbuildinfo

# Root scratch directory: retained verification logs, probe scripts and the
# tarball-install probes. Ignored since this wave; the files that were already
# here are kept, not deleted.
/tmp/

docs/superpowers/
/debug/