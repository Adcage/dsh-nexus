# Repository text is UTF-8 without BOM. Text created from here on is LF in the
# working tree, even though this Windows host sets core.autocrlf=true.
* text=auto

*.ts           text eol=lf
*.tsx          text eol=lf
*.mts          text eol=lf
*.js           text eol=lf
*.mjs          text eol=lf
*.cjs          text eol=lf
*.json         text eol=lf
*.css          text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf
.gitattributes text eol=lf

# The four pre-existing documents were authored with CRLF line endings and must
# keep their exact bytes; `diff` keeps them reviewable as text instead of binary.
docs/plans/2026-10-31-dsh-nexus-design.md                      -text diff
docs/superpowers/plans/2026-11-01-dsh-nexus-implementation.md   -text diff
docs/superpowers/specs/2026-10-31-dsh-nexus-design.md           -text diff
docs/superpowers/specs/future/2026-10-31-dsh-nexus-assembly-design.md -text diff

# Binary assets are never line-ending normalized.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.tgz  binary
*.woff binary
*.woff2 binary
